# Exports

# ls colors (GNU ls)
export LS_COLORS="di=01;34:fi=00:ln=01;36:pi=40;33"

# --- PATH ---
_path_prepend() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in *":$1:"*) ;; *) PATH="$1:$PATH" ;; esac
}
_path_prepend "$HOME/.local/bin"      # pipx, uv tools
_path_prepend "$HOME/.fw_setup"
_path_prepend "${CARGO_HOME:-$HOME/.cargo}/bin"   # rustup/cargo
export PATH
unset -f _path_prepend

# --- Embedded / firmware tooling ---
[ -d "$HOME/.zephyr_sdk" ] && export ZEPHYR_SDK_INSTALL_DIR="$HOME/.zephyr_sdk/"

# picocom line mapping used across the team (picocom $PICOMAP /dev/ttyUSB0)
export PICOMAP="--imap lfcrlf --omap crcrlf,delbs"
