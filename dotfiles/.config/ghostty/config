# Merged: laptop (Kubuntu-tuned look) + Mac (window size, blur).
# Drop-down toggle: Alt+Shift+A runs ~/.local/bin/toggle-ghostty.sh (KWin script).

# ─── Font & Appearance ────────────────────────────────────────────────────────
font-family = "JetBrains Mono"
font-size = 15
theme = Dark+
background-opacity = 0.80
background-blur-radius = 20

# ─── Window ───────────────────────────────────────────────────────────────────
window-padding-x = 10
window-padding-y = 10
window-decoration = false
window-width = 100
window-height = 30

# ─── Behavior ─────────────────────────────────────────────────────────────────
term = xterm-256color
confirm-close-surface = false
mouse-hide-while-typing = true
scrollback-limit = 10000
cursor-style = block
copy-on-select = true
